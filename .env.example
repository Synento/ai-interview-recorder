# Secret server-side key. Required.
# Copy this file to .env.local and set an sk_live_ key from the dashboard (API keys).
# Replay and MP4 export need that key. An rk_live_ restricted key is refused.
# Never commit .env.local, and never send this key to the browser.
SYNENTO_API_KEY=sk_live_replace_me

# Optional. Defaults to https://api.synento.com
# SYNENTO_API_URL=https://api.synento.com
